    "@types/node": "^22.20.1",
    "@vue/tsconfig": "^0.9.1",
    "knip": "^5.88.1",
    "lefthook": "^1.13.6",
    "mkdist": "^1.6.0",
    "rollers": "^0.3.0",
    "unbuild": "^2.0.0",
    "vitepress": "^1.6.4"
